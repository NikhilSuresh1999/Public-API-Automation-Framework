{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CartSchema",
  "type": "object",
  "required": ["id", "products", "total", "discountedTotal", "userId", "totalProducts", "totalQuantity"],
  "properties": {
    "id": { "type": "integer" },
    "products": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "price", "quantity", "total", "discountPercentage", "discountedTotal"],
        "properties": {
          "id": { "type": "integer" },
          "title": { "type": "string" },
          "price": { "type": ["number", "integer"] },
          "quantity": { "type": "integer" },
          "total": { "type": ["number", "integer"] },
          "discountPercentage": { "type": ["number", "integer"] },
          "discountedTotal": { "type": ["number", "integer"] },
          "thumbnail": { "type": "string" }
        }
      }
    },
    "total": { "type": ["number", "integer"] },
    "discountedTotal": { "type": ["number", "integer"] },
    "userId": { "type": "integer" },
    "totalProducts": { "type": "integer" },
    "totalQuantity": { "type": "integer" }
  }
}

