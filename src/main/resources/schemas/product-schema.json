{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ProductSchema",
  "type": "object",
  "required": ["id", "title", "price"],
  "properties": {
    "id": { "type": "integer" },
    "title": { "type": "string" },
    "description": { "type": "string" },
    "price": { "type": ["number", "integer"] },
    "discountPercentage": { "type": ["number", "integer"] },
    "rating": { "type": ["number", "integer"] },
    "stock": { "type": "integer" },
    "brand": { "type": "string" },
    "category": { "type": "string" },
    "thumbnail": { "type": "string" },
    "images": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}

